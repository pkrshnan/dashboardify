# Absolute path to the Markdown vault (an Obsidian vault works as-is).
VAULT_PATH=/srv/vault
# IANA time zone used to decide which day an entry belongs to.
TZ_NAME=America/Los_Angeles
PORT=8787
# device:token pairs, comma separated, at least 16 characters each.
# Generate one with: openssl rand -hex 24
INGEST_TOKENS=iphone:replace-with-a-long-random-token
# Git sync runs when VAULT_PATH is a git repo. Set GIT_SYNC=off to disable.
# GIT_SYNC=off
# GIT_COMMIT_DELAY_MS=30000
# GIT_PULL_INTERVAL_MS=300000
