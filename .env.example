# Absolute path to your Markdown vault (an Obsidian vault works as-is).
VAULT_PATH=/srv/vault
# IANA time zone used to decide which day a journal line or message belongs to.
TZ_NAME=America/Los_Angeles
PORT=8787
# device:token pairs, comma separated. Tokens must be at least 16 characters.
# Generate one with: openssl rand -hex 24
INGEST_TOKENS=iphone:replace-with-a-long-random-token
