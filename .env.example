# Startup values: what the server needs before it can open Settings. Everything else (time
# zone, tasks inbox, devices, tailnet sign-in, calendars) lives in Settings, in settings.db.

# Path to the Markdown vault (an Obsidian vault works as-is). ./vault is a git-ignored symlink
# to your real vault; see "Your vault" in the README. On the server, point it at the folder
# livesync-bridge writes to.
VAULT_PATH=./vault
PORT=8787
# Settings, devices and the secret key live here, outside the vault. Defaults to ./data.
# Back it up, but leave secret.key out of the backup and keep a copy in your password manager.
DATA_PATH=./data
# Use a Docker or systemd secret as the key instead of $DATA_PATH/secret.key.
# SECRET_KEY_FILE=/run/secrets/dashboardify-key
# Raw health samples (Parquet), kept outside the vault. Defaults to health-raw next to the vault.
HEALTH_RAW_PATH=./health-raw
# Computed health tables (Parquet), rebuildable from the raw samples. Defaults to
# health-derived next to the vault.
HEALTH_DERIVED_PATH=./health-derived

# Place search for event locations. Defaults to the public Photon server (OpenStreetMap), which
# asks for fair use; point it at your own Photon to keep searches on your network.
# PHOTON_URL=https://photon.komoot.io
