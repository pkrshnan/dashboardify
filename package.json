{
  "name": "dashboardify",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run typecheck && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@types/bun": "1.4.4",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "async-mutex": "0.5.0",
    "gray-matter": "4.0.3",
    "hono": "4.13.16",
    "yaml": "2.9.1"
  }
}
