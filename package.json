{
  "name": "dashboardify",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.4",
  "scripts": {
    "dev": "bun --watch src/main.ts",
    "start": "bun src/main.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "check": "bun run lint && bun run proto:lint && bun run typecheck && bun test",
    "demo": "bun scripts/demo.ts",
    "proto:lint": "buf format --diff --exit-code && buf lint"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.4",
    "@bufbuild/buf": "1.47.2",
    "@types/bun": "1.4.4",
    "@types/papaparse": "5.3.16",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "async-mutex": "0.5.0",
    "chrono-node": "2.10.3",
    "fuse.js": "7.5.0",
    "gray-matter": "4.0.3",
    "hono": "4.13.16",
    "hyparquet": "1.32.0",
    "hyparquet-writer": "0.18.0",
    "papaparse": "5.5.3",
    "preact": "10.27.2",
    "yaml": "2.9.1"
  }
}
