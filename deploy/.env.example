# Copy to .env (git-ignored) and fill in. Generate random values with: openssl rand -hex 24
# Keep passwords and passphrases to letters and digits; some are written into JSON as-is.

# Where every service keeps its data on the host. Create it with ./setup.sh.
DATA_DIR=/srv/homeserver
# Time zone for cron schedules and for which day an entry belongs to.
TZ=America/Los_Angeles
TZ_NAME=America/Los_Angeles

# --- Tailscale -------------------------------------------------------------------------------
# A reusable or one-off auth key from https://login.tailscale.com/admin/settings/keys.
# Only needed for the first start; the node's identity is kept in DATA_DIR/tailscale.
TS_AUTHKEY=
TS_HOSTNAME=homeserver

# --- dashboardify ----------------------------------------------------------------------------
# device:token pairs for your devices, comma separated, 16+ characters per token.
INGEST_TOKENS=iphone:replace-with-a-long-random-token
TASKS_INBOX=Inbox.md

# --- healthstrap -----------------------------------------------------------------------------
# Token the strap daemon uploads with. Added to dashboardify's tokens automatically.
HEALTHSTRAP_TOKEN=replace-with-a-long-random-token
# Build source. Defaults to the main branch on GitHub; point it at a local checkout to test.
# HEALTHSTRAP_SRC=/home/pranav/src/healthstrap

# --- Obsidian LiveSync -----------------------------------------------------------------------
COUCHDB_USER=livesync
COUCHDB_PASSWORD=replace-me
# Must match the database name and passphrases you set in the LiveSync plugin.
LIVESYNC_DATABASE=obsidian
LIVESYNC_PASSPHRASE=replace-me
# Same as LIVESYNC_PASSPHRASE if path obfuscation is on in LiveSync, otherwise empty.
LIVESYNC_OBFUSCATE_PASSPHRASE=

# --- Backups (restic to Cloudflare R2) -------------------------------------------------------
# R2 > Manage API tokens: an Object Read & Write token for one bucket.
RESTIC_REPOSITORY=s3:https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Encrypts the backups. Lose it and the backups are unreadable, so keep a copy off the server.
RESTIC_PASSWORD=replace-me
BACKUP_SCHEDULE=30 3 * * *

# --- FoundryVTT ------------------------------------------------------------------------------
FOUNDRY_MAJOR=14
FOUNDRY_USERNAME=
FOUNDRY_PASSWORD=
# Password for Foundry's setup screen.
FOUNDRY_ADMIN_KEY=replace-me
# The public hostname you gave the tunnel, e.g. foundry.example.com
FOUNDRY_HOSTNAME=
# Zero Trust > Networks > Tunnels > your tunnel > the token in the install command.
CLOUDFLARE_TUNNEL_TOKEN=
