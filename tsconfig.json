{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "ESNext.Temporal"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "noEmit": true
  },
  "include": ["src", "test"]
}
